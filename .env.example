# Broker MQTT untuk browser harus memakai WebSocket, bukan port TCP 1883.
VITE_MQTT_URL=ws://broker.emqx.io:8083/mqtt
VITE_MQTT_USERNAME=
VITE_MQTT_PASSWORD=

# Endpoint MJPEG Gateway dari server Python OpenCV.
VITE_RTSP_MJPEG_URL=http://localhost:5000/video_feed

# Tanggal mulai batch aktif.
VITE_INKUBASI_START=2026-06-02T07:00:00

# Kode akses demo untuk mode Admin dan Operator.
# Catatan: untuk produksi, verifikasi role harus diproses di backend, bukan hanya frontend.
VITE_ADMIN_ACCESS_CODE=ADMIN
VITE_OPERATOR_ACCESS_CODE=OPERATOR

# URL REST API Backend FastAPI/MySQL (Kosongkan untuk fallback offline localStorage)
VITE_API_BASE_URL=http://localhost:8000
